#!/bin/bash
# 51team CLI — 统一入口
# 用法: 51team <command> [args...]

# Resolve symlinks to find the real script directory
_realpath() {
  local p="$1"
  local max=10
  while [ $max -gt 0 ] && [ -L "$p" ]; do
    local target="$(readlink "$p")"
    case "$target" in
      /*) p="$target" ;;
      *)  p="$(cd "$(dirname "$p")" && pwd)/$target" ;;
    esac
    max=$((max - 1))
  done
  dirname "$p"
}
SCRIPT_DIR="$(cd "$(_realpath "$0")" && pwd)"
PORT="${MCP_BRIDGE_PORT:-9876}"
LAUNCH_LABEL="com.51team.router"
LAUNCH_PLIST="${HOME}/Library/LaunchAgents/${LAUNCH_LABEL}.plist"
PID_FILE="${HOME}/.claude/51team/router.pid"
LOG_FILE="${HOME}/.claude/51team/router.log"

# ── Colors ──
GREEN='\033[0;32m'
RED='\033[0;31m'
YELLOW='\033[1;33m'
CYAN='\033[0;36m'
NC='\033[0m'

# ── Help ──
usage() {
  cat <<EOF
${CYAN}51team${NC} — 我要 team · MCP + tmux 多 Agent 协作

${CYAN}Commands:${NC}
  up              启动 Router（幂等）
  down            停止 Router（禁用自动恢复）
  restart         重启 Router
  status          查看 Router 状态 + Agent 列表
  ps              查看 Agent 在线/离线/过期状态
  team <项目> <角色1,角色2,...> [任务]
                  一键组队
  destroy [项目]   退出团队：杀掉 tmux session + 清除状态
  logs            实时日志（tail -f）
  clean           清除所有状态
  uninstall       卸载：清状态、删 LaunchAgent、删 symlink
  dashboard       打开 Web Dashboard

${CYAN}Env:${NC}
  MCP_BRIDGE_PORT             Router 端口（默认 9876）
  ANTHROPIC_MODEL             Agent 模型（默认 deepseek-v4-flash）
  CLAUDE_CODE_EFFORT_LEVEL    Agent effort（默认 low）

${CYAN}Files:${NC}
  Router:    ${SCRIPT_DIR}/server-http.js
  Log:       ${LOG_FILE}
  State:     ${HOME}/.claude/51team/state.json
  Dashboard: http://127.0.0.1:${PORT}/
EOF
}

# ── Helpers ──

router_running() {
  curl -s "http://127.0.0.1:${PORT}/health" > /dev/null 2>&1
}

router_pid() {
  lsof -ti:${PORT} 2>/dev/null
}

launchctl_loaded() {
  launchctl list 2>/dev/null | grep -q "$LAUNCH_LABEL"
}

launchctl_load() {
  if [ -f "$LAUNCH_PLIST" ]; then
    launchctl bootout "gui/$(id -u)/${LAUNCH_LABEL}" 2>/dev/null || true
    launchctl bootstrap "gui/$(id -u)" "$LAUNCH_PLIST" 2>/dev/null
  fi
}

launchctl_unload() {
  launchctl bootout "gui/$(id -u)/${LAUNCH_LABEL}" 2>/dev/null || true
}

# ── Commands ──

cmd_up() {
  if router_running; then
    echo -e "${GREEN}✅${NC} Router 已在运行 (port ${PORT})"
    echo "   PID: $(router_pid)"
    if ! launchctl_loaded; then
      echo -e "   ${YELLOW}⚠️${NC}  LaunchAgent 未加载，重启后不会自动恢复"
    fi
    return 0
  fi

  # If LaunchAgent plist exists, load it (it will auto-start the router)
  if [ -f "$LAUNCH_PLIST" ]; then
    echo -n "通过 LaunchAgent 启动..."
    launchctl_load
    for i in $(seq 1 10); do
      sleep 1
      if router_running; then
        echo -e " ${GREEN}✅${NC}"
        echo "   PID: $(router_pid)  ·  Port: ${PORT}"
        echo "   Dashboard: http://127.0.0.1:${PORT}/"
        return 0
      fi
    done
    echo -e " ${RED}❌${NC}"
    echo "   启动失败，检查: 51team logs"
    return 1
  fi

  # Fallback: manual start (no LaunchAgent installed)
  echo -n "手动启动 Router..."
  cd "$SCRIPT_DIR"
  nohup node server-http.js > /dev/null 2>&1 &
  local pid=$!
  echo "$pid" > "$PID_FILE"
  for i in $(seq 1 10); do
    sleep 1
    if router_running; then
      echo -e " ${GREEN}✅${NC}"
      echo "   PID: ${pid}  ·  Port: ${PORT}"
      echo "   Dashboard: http://127.0.0.1:${PORT}/"
      return 0
    fi
  done
  echo -e " ${RED}❌${NC}"
  return 1
}

cmd_down() {
  if ! router_running; then
    echo -e "${YELLOW}⚠️${NC}  Router 未运行"
    launchctl_unload
    rm -f "$PID_FILE"
    return 0
  fi

  echo -n "停止 Router..."
  # Unload LaunchAgent first so it won't restart
  launchctl_unload
  local pid=$(router_pid)
  kill "$pid" 2>/dev/null || true
  sleep 1
  if router_running; then
    lsof -ti:${PORT} | xargs kill -9 2>/dev/null || true
  fi
  rm -f "$PID_FILE"
  echo -e " ${GREEN}✅${NC}"
}

cmd_restart() {
  cmd_down
  sleep 1
  cmd_up
}

cmd_status() {
  echo -e "${CYAN}═══ 51team Status ═══${NC}"
  echo ""

  if router_running; then
    echo -e "Router:       ${GREEN}● RUNNING${NC}"
    echo "PID:          $(router_pid)"
    echo "Port:         ${PORT}"

    if launchctl_loaded; then
      echo -e "LaunchAgent:  ${GREEN}● LOADED${NC} (崩溃自动恢复)"
    else
      echo -e "LaunchAgent:  ${YELLOW}○ NOT LOADED${NC}"
    fi

    echo "Log:          ${LOG_FILE}"

    local state=$(curl -s "http://127.0.0.1:${PORT}/api/state" 2>/dev/null)
    if [ -n "$state" ]; then
      local agents=$(echo "$state" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['stats']['totalAgents'])" 2>/dev/null || echo "0")
      local online=$(echo "$state" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['stats']['onlineAgents'])" 2>/dev/null || echo "0")
      local msgs=$(echo "$state" | python3 -c "import sys,json;d=json.load(sys.stdin);print(d['stats']['totalMessages'])" 2>/dev/null || echo "0")
      local uptime=$(echo "$state" | python3 -c "import sys,json;d=json.load(sys.stdin);print(round(d['uptime']))" 2>/dev/null || echo "0")
      local m=$((uptime / 60))
      local s=$((uptime % 60))
      echo ""
      echo "Uptime:       ${m}m ${s}s"
      echo "Agents:       ${agents} (${online} online)"
      echo "Messages:     ${msgs}"

      local agentList=$(echo "$state" | python3 -c "
import sys,json
d=json.load(sys.stdin)
for a in d.get('agents', []):
    status = '🟢' if a.get('online') else '🔴'
    print(f'  {status} {a[\"name\"]}  ({a[\"tmuxSession\"]})')
" 2>/dev/null)
      if [ -n "$agentList" ]; then
        echo ""
        echo "Agents:"
        echo "$agentList"
      fi
    fi
  else
    echo -e "Router:       ${RED}● STOPPED${NC}"
    if launchctl_loaded; then
      echo -e "LaunchAgent:  ${YELLOW}● LOADED${NC} (Router 未运行？)"
    else
      echo -e "LaunchAgent:  ${RED}○ NOT LOADED${NC}"
    fi
  fi

  echo ""
  echo -e "Dashboard:    ${CYAN}http://127.0.0.1:${PORT}/${NC}"
}

cmd_team() {
  if [ $# -lt 2 ]; then
    echo "用法: 51team team <项目名> <角色1,角色2,...> [任务描述]"
    echo "示例: 51team team myapp 'architect,frontend,backend' '做一个用户系统'"
    return 1
  fi

  if ! router_running; then
    echo -n "Router 未运行，先启动..."
    cmd_up || return 1
  fi

  exec "${SCRIPT_DIR}/team-up.sh" "$@"
}

cmd_logs() {
  if [ -f "$LOG_FILE" ]; then
    echo -e "${CYAN}Tailing ${LOG_FILE}${NC} (Ctrl-C to exit)"
    echo ""
    tail -f "$LOG_FILE"
  else
    echo -e "${YELLOW}暂无日志${NC}"
  fi
}

cmd_clean() {
  echo -n "清除所有状态..."
  curl -s -X POST "http://127.0.0.1:${PORT}/api/clear" > /dev/null 2>&1 && echo -e " ${GREEN}✅${NC}" || echo -e " ${RED}❌${NC} (Router 是否在运行？)"
}

cmd_ps() {
  if ! router_running; then
    echo -e "${YELLOW}Router 未运行${NC}"
    return 1
  fi
  local state=$(curl -s "http://127.0.0.1:${PORT}/api/state" 2>/dev/null)
  if [ -z "$state" ]; then
    echo -e "${RED}无法获取状态${NC}"
    return 1
  fi
  echo -e "${CYAN}Agent${NC}                ${CYAN}Status${NC}    ${CYAN}Session${NC}           ${CYAN}Last Heartbeat${NC}"
  echo "─────────────────────────────────────────────────"
  echo "$state" | python3 -c "
import sys, json
from datetime import datetime, timezone
d = json.load(sys.stdin)
now = datetime.now(timezone.utc)
for a in d.get('agents', []):
    name = a['name']
    online = a.get('online', False)
    session = a.get('tmuxSession', '?')
    hb = a.get('lastHeartbeat') or a.get('registeredAt', '')
    if hb:
        age = (now - datetime.fromisoformat(hb.replace('Z','+00:00'))).total_seconds()
        hb_str = f'{int(age)}s ago' if age < 120 else f'{int(age//60)}m ago'
    else:
        hb_str = 'never'
    status = '🟢 LIVE' if online else ('🔴 GONE' if hb else '⚫ EXP')
    print(f'{name:<20} {status:<8} {session:<18} {hb_str}')
  " 2>/dev/null || echo "  (no agents)"
}

cmd_destroy() {
  local project="${1:-}"
  if [ -z "$project" ]; then
    echo "用法: 51team destroy <项目名>"
    echo "示例: 51team destroy myapp"
    return 1
  fi

  echo "退出团队: ${project}"

  # 1. 从 Router 注销项目内 agent（不调用 api/clear，避免影响其他项目）
  if router_running; then
    local state=$(curl -s "http://127.0.0.1:${PORT}/api/state" 2>/dev/null)
    if [ -n "$state" ]; then
      local names=$(echo "$state" | python3 -c "
import sys, json
d = json.load(sys.stdin)
project = '${project}'
for a in d.get('agents', []):
    s = a.get('tmuxSession', '')
    if s.startswith(project + '-'):
        print(a['name'])
" 2>/dev/null)
      for name in $names; do
        local body="{\"tool\":\"unregister_agent\",\"args\":{\"agent_name\":\"${name}\"}}"
        curl -s -X POST "http://127.0.0.1:${PORT}/api/call" \
          -H "Content-Type: application/json" -d "$body" > /dev/null
        echo "  注销 agent: ${name}"
      done
    fi
  fi

  # 2. 按前缀杀 tmux session（无论 Router 是否在线、是否有状态）
  local sessions=$(tmux list-sessions 2>/dev/null | grep "^${project}-" | cut -d: -f1)
  local count=0
  for s in $sessions; do
    tmux kill-session -t "$s" 2>/dev/null && echo "  ✅ 已终止: $s" && count=$((count + 1))
  done
  [ "$count" -gt 0 ] && echo "  共终止 $count 个 tmux session" || echo "  (没有活跃的 tmux session)"
  echo "团队 ${project} 已退出"
}

cmd_uninstall() {
  echo "卸载 51team..."
  # Stop Router
  cmd_down
  # Remove LaunchAgent
  if [ -f "$LAUNCH_PLIST" ]; then
    echo -n "删除 LaunchAgent..."
    launchctl bootout "gui/$(id -u)/${LAUNCH_LABEL}" 2>/dev/null || true
    rm -f "$LAUNCH_PLIST"
    echo -e " ${GREEN}✅${NC}"
  fi
  # Remove state
  echo -n "删除状态文件..."
  rm -rf "${HOME}/.claude/51team" 2>/dev/null && echo -e " ${GREEN}✅${NC}" || echo ""
  # Remove symlink
  echo -n "删除 CLI..."
  rm -f "${HOME}/.local/bin/51team" 2>/dev/null && echo -e " ${GREEN}✅${NC}" || echo ""
  echo "完成。要彻底删除，再手动: rm -rf ${SCRIPT_DIR}"
}

cmd_dashboard() {
  echo "Dashboard: http://127.0.0.1:${PORT}/"
  echo "打开浏览器粘贴此地址。第一次打开后，数据会自动刷新。"
}

cmd_daemon() {
  # Background daemon mode — for LaunchAgent
  # Just runs the router in foreground (launchd manages lifecycle)
  cd "$SCRIPT_DIR"
  exec node server-http.js
}

# ── Dispatch ──
case "${1:-}" in
  up)        shift; cmd_up "$@" ;;
  down)      shift; cmd_down "$@" ;;
  restart)   shift; cmd_restart "$@" ;;
  status)    shift; cmd_status "$@" ;;
  ps)        shift; cmd_ps "$@" ;;
  team)      shift; cmd_team "$@" ;;
  destroy)   shift; cmd_destroy "$@" ;;
  logs)      shift; cmd_logs "$@" ;;
  clean)     shift; cmd_clean "$@" ;;
  uninstall) shift; cmd_uninstall "$@" ;;
  dashboard) shift; cmd_dashboard "$@" ;;
  daemon)    shift; cmd_daemon "$@" ;;
  version|--version|-V) shift; echo "51team $(cat "${SCRIPT_DIR}/VERSION")" ;;
	  help|--help|-h) usage ;;
  *)
    if [ $# -ge 2 ]; then
      cmd_team "$@"
    else
      usage
    fi
    ;;
esac
